# JustSay Backend Configuration
# Copy this file to .env and fill in your values.

# === App ===
JUSTSAY_HOST=127.0.0.1
JUSTSAY_PORT=9377
JUSTSAY_DEBUG=false

# === STT (Speech-to-Text) ===
# Mode: "cloud" or "local"
JUSTSAY_STT_MODE=cloud

# Cloud transcription: Groq Whisper, for every recording
# Get a free key at https://console.groq.com/keys
JUSTSAY_STT_GROQ_API_KEY=
JUSTSAY_STT_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Cloud semantic search: Gemini embeddings
# Get a free key at https://aistudio.google.com/apikey
JUSTSAY_STT_GEMINI_API_KEY=

# Local (faster-whisper — pip install justsay-backend[local])
JUSTSAY_STT_WHISPER_MODEL_SIZE=large-v3-turbo
JUSTSAY_STT_WHISPER_DEVICE=auto

# === Embeddings (semantic search) ===
# Eligibility follows JUSTSAY_STT_MODE alone: cloud reuses the Gemini key,
# local needs Ollama with nomic-embed-text pulled.
# Ollama is optional: pip install justsay-backend[local-llm]
JUSTSAY_EMBEDDINGS_OLLAMA_HOST=http://localhost:11434

# === Audio ===
JUSTSAY_AUDIO_SAMPLE_RATE=16000
JUSTSAY_AUDIO_CHANNELS=1
