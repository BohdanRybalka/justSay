# JustSay Backend Configuration
# Copy this file to .env and fill in your values.

# === App ===
JUSTSAY_HOST=127.0.0.1
JUSTSAY_PORT=9377
JUSTSAY_DEBUG=false

# === STT (Speech-to-Text) ===
# Mode: "cloud" or "local"
JUSTSAY_STT_MODE=cloud

# Cloud long-audio / ai_prompt: Gemini
# Get a free key at https://aistudio.google.com/apikey
JUSTSAY_STT_GEMINI_API_KEY=
JUSTSAY_STT_GEMINI_MODEL=gemini-2.5-flash

# Cloud short-audio (<= threshold, normal style): Groq Whisper
# Get a free key at https://console.groq.com/keys
# You can reuse the same Groq key as JUSTSAY_LLM_GROQ_API_KEY — they're independent modules.
JUSTSAY_STT_GROQ_API_KEY=
JUSTSAY_STT_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Smart routing threshold (seconds). Audio <= this goes to Groq; above -> Gemini.
JUSTSAY_STT_CLOUD_ROUTING_THRESHOLD=30.0

# Local (faster-whisper — pip install justsay-backend[local])
JUSTSAY_STT_WHISPER_MODEL_SIZE=large-v3-turbo
JUSTSAY_STT_WHISPER_DEVICE=auto

# === LLM mode + Ollama (gates local embeddings; no text-processing endpoint) ===
# There is no LLM cleanup step and no /llm/* endpoint — Gemini/Groq handle both
# transcription and cleanup. JUSTSAY_LLM_MODE is one half of the Cloud/Local key
# that decides embedding-provider eligibility, and the Ollama host/model feed
# the local embedding provider.
JUSTSAY_LLM_MODE=cloud
JUSTSAY_LLM_GROQ_API_KEY=
JUSTSAY_LLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Ollama is now optional: pip install justsay-backend[local-llm]
JUSTSAY_LLM_OLLAMA_HOST=http://localhost:11434
JUSTSAY_LLM_OLLAMA_MODEL=qwen3:1.7b

# === Audio ===
JUSTSAY_AUDIO_SAMPLE_RATE=16000
JUSTSAY_AUDIO_CHANNELS=1
