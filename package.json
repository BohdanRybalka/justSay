{
  "name": "justsay",
  "version": "0.11.1",
  "description": "Personal voice-processing OS with hybrid Cloud/Local AI architecture",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('src-tauri/resources/whisper-cpp-vulkan',{recursive:true})\" && vite",
    "build": "node -e \"require('fs').mkdirSync('src-tauri/resources/whisper-cpp-vulkan',{recursive:true})\" && tsc && vite build",
    "tauri:dev": "tauri dev",
    "tauri:dev:frozen": "npm run sidecar:build && cross-env JUSTSAY_USE_FROZEN_SIDECAR=1 tauri dev",
    "sidecar:build": "cd backend && pyinstaller build_sidecar.spec --noconfirm --distpath ../src-tauri/resources",
    "backend": "cd backend && python -m uvicorn app.main:app --host 127.0.0.1 --port 9377 --reload",
    "backend:install": "cd backend && pip install -e \".[dev,audio,cloud]\"",
    "setup": "npm install && npm run backend:install",
    "test": "cd backend && python -m pytest tests/ -v",
    "test:frontend": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "lint:dead-code:ts": "knip",
    "lint:dead-code:py": "cd backend && python -m vulture",
    "lint:dead-code": "npm run lint:dead-code:ts && npm run lint:dead-code:py"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "playwright-cli": "^0.262.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "cross-env": "^7.0.3",
    "knip": "5.88.1",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
