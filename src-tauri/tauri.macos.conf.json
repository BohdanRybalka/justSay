{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "JustSay",
        "url": "/index.html",
        "width": 1044,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 21 }
      }
    ]
  },
  "bundle": {
    "resources": {
      "resources/justsay-backend": "justsay-backend",
      "resources/whisper-cpp-metal": "whisper-cpp-metal",
      "resources/justsay-audiotap": "justsay-audiotap"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
