{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JustSay",
  "version": "0.10.4",
  "identifier": "com.justsay.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "JustSay Settings",
        "url": "/index.html",
        "width": 960,
        "height": 720,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:9377 http://localhost:9377; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/justsay-backend": "justsay-backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BohdanRybalka/justSay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MjM5Qzk5QzEyMUZCRjkKUldUNSt5SEJtWndqOXphMXo2a01sQ05ZVHlRd2paQVVYRys4K2cwRnliQUdjS21oaDUzY3Mwbk8K",
      "dialog": false
    }
  }
}
