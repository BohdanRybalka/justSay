{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JustSay",
  "version": "0.9.0",
  "identifier": "com.justsay.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "JustSay Settings",
        "url": "/index.html",
        "width": 680,
        "height": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:9377 http://localhost:9377; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/justsay-backend"]
  },
  "plugins": {}
}
