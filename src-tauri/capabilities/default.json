{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for JustSay",
  "windows": ["widget", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "notification:default",
    "dialog:default",
    "fs:allow-read-file",
    "updater:default",
    "shell:default",
    "process:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" },
        { "path": "$TEMP/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "justsay-backend-win",
          "cmd": "$RESOURCE/justsay-backend/justsay-backend.exe",
          "args": [
            { "validator": "--host" },
            { "validator": "127\\.0\\.0\\.1" },
            { "validator": "--port" },
            { "validator": "\\d+" }
          ],
          "sidecar": false
        },
        {
          "name": "justsay-backend-unix",
          "cmd": "$RESOURCE/justsay-backend/justsay-backend",
          "args": [
            { "validator": "--host" },
            { "validator": "127\\.0\\.0\\.1" },
            { "validator": "--port" },
            { "validator": "\\d+" }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
